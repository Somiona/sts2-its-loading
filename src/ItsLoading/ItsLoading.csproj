<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.14.0</Version>
    <AssemblyName>ItsLoading</AssemblyName>
    <RootNamespace>ItsLoading</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- ReadyToRun:仅 dotnet publish -r <rid> 时生效(build 不做 R2R)。v0.13.2 试验结论:JIT 不是瓶颈。
         勿在 csproj 硬编码 RuntimeIdentifier——它只会把 build 输出挪进 RID 子目录,而 build/install
         脚本与跨平台构建(Windows/Linux)都假定单一 net9.0/ 输出路径(v0.13.2 曾因此装旧 dll,见 todo#2) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 进度条 UI 阶段再换 Godot.NET.Sdk(需要源生成器);当前纯静态类无需 -->
  </PropertyGroup>

  <!-- 游戏安装位置自动发现(三平台;可用 local.props 或 -p:Sts2Dir= 覆盖) -->
  <Import Project="Sts2PathDiscovery.props"/>

  <ItemGroup>
    <!-- 测试工程访问 internal(BootTimeline 写缝) -->
    <InternalsVisibleTo Include="ItsLoadingTimeline.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用直达本机游戏目录,仓库不含任何游戏侧二进制 -->
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ReportSts2DataDir" BeforeTargets="BeforeBuild">
    <Message Text="STS2 reference dir: $(Sts2DataDir)" Importance="high"/>
  </Target>
</Project>
