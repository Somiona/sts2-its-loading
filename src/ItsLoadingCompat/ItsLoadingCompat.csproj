<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.0.2</Version>
    <AssemblyName>ItsLoadingCompat</AssemblyName>
    <RootNamespace>ItsLoadingCompat</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- BaseLib 引用只存在于本垫片:主 dll 绝不引用(见主工程注释) -->
    <Reference Include="BaseLib">
      <HintPath>../ItsLoading/refs/BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItsLoading">
      <HintPath>../ItsLoading/bin/Release/net9.0/ItsLoading.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
